:root {
    -unity-font-definition: url("project://database/Assets/Fonts/VCR_OSD_MONO%20SDF-internal.asset?fileID=11400000&guid=19aad70f333df446fa14a26603c1ab70&type=2#VCR_OSD_MONO SDF-internal");
    -unity-material: url("project://database/Assets/Shaders/RetroStaticUI.shadergraph?fileID=-876546973899608171&guid=69700b1ae33124c94ba8dda5b7003190&type=3#RetroStaticUI");
    -unity-text-generator: standard;
    --Primary: rgba(93, 211, 158, 0.9);
    --Secondary: rgba(211, 95, 147, 0.8);
    --Background: rgb(39, 33, 60);
    opacity: 1;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-right-radius: 2px;
    border-bottom-left-radius: 2px;
    --Red: rgb(229, 61, 61);
}

.primary {
    background-color: var(--Primary);
    color: var(--Secondary);
}

.primary > Label {
    color: var(--Secondary);
}

.primary > Image {
    -unity-background-image-tint-color: var(--Secondary);
}

.secondary {
    background-color: var(--Secondary);
}

.secondary > Label {
    background-color: rgba(255, 255, 255, 0);
    -unity-background-image-tint-color: rgb(255, 255, 255);
    opacity: 1;
    color: var(--Primary);
}

.background {
    background-color: var(--Background);
}

.dangerButton {
    background-color: var(--Red);
    color: rgb(255, 255, 255);
    transition-duration: 0.3s;
}

.dangerButton:hover {
    background-color: var(--Red);
    color: rgb(255, 255, 255);
    scale: 1.05 1.05 1.05;
    filter: grayscale(0.8);
    transition-duration: 0.3s;
}

.expandableList {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    background-color: rgba(0, 0, 0, 0);
    transition-duration: 1s;
    overflow: hidden;
    position: relative;
    height: 60px;
    max-height: none;
    transition-property: height;
}

.expandableList:focus {
    overflow: hidden;
    transition-duration: 1s;
    height: 500px;
    transition-property: height;
}

.expandableList > #Options {
    opacity: 0.2;
    transition-property: opacity;
    transition-duration: 0.5s;
}

.expandableList:focus > #Options {
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.5s;
}

.expandableList > #ListName > #Arrow {
    height: 32px;
    width: 32px;
    aspect-ratio: 1;
    background-image: url("project://database/Assets/Images/HUD/TriangleIcon.png?fileID=2800000&guid=8f9c29442f01da7da8cc4ce9c2155acc&type=3#TriangleIcon");
    background-color: rgba(255, 255, 255, 0);
    rotate: 90deg;
    transition-property: rotate;
    transition-duration: 1s;
}

.expandableList:focus > #ListName > #Arrow {
    height: 32px;
    width: 32px;
    aspect-ratio: 1;
    background-image: url("project://database/Assets/Images/HUD/TriangleIcon.png?fileID=2800000&guid=8f9c29442f01da7da8cc4ce9c2155acc&type=3#TriangleIcon");
    background-color: rgba(255, 255, 255, 0);
    rotate: 180deg;
    transition-property: rotate;
    transition-duration: 1s;
}
