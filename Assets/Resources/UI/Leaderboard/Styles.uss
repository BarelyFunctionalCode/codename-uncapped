Leaderboard {
    flex-shrink: 0;
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    align-content: center;
}

#Container {
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    flex-grow: 0;
    width: 80%;
    height: 90%;
    align-items: center;
    padding-top: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
}

#GameModeName {
    font-size: 35px;
    -unity-text-align: middle-center;
    margin-top: 10px;
    margin-right: 10px;
    margin-bottom: 30px;
    margin-left: 10px;
}

#CharacterData {
    flex-grow: 1;
    flex-shrink: 0;
    width: 100%;
    flex-direction: row;
}

.section {
    flex-grow: 1;
    flex-shrink: 0;
    align-items: stretch;
}

#SectionBorder {
    flex-grow: 0;
    height: 100%;
    flex-shrink: 0;
    margin-top: 0;
    margin-bottom: 0;
    width: 5px;
    margin-right: 10px;
    margin-left: 10px;
}

.columnHeader {
    font-size: 18px;
    flex-shrink: 0;
    white-space: nowrap;
    width: 45px;
    -unity-font-style: italic;
}

.row {
    flex-grow: 0;
    width: 100%;
    height: auto;
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 5px;
}

#SectionHeaderBorder {
    flex-grow: 0;
    height: 5px;
    flex-shrink: 0;
    margin-top: 10px;
    margin-bottom: 10px;
    width: 100%;
}

#SectionBody {
    flex-grow: 1;
    flex-shrink: 0;
    align-items: center;
}

#Stats {
    flex-grow: 0;
    flex-direction: row;
    align-content: stretch;
    flex-shrink: 0;
    width: 40%;
    justify-content: space-between;
}

.columnRow {
    font-size: 18px;
    width: 45px;
}

#LeaderboardRow > #Name {
    flex-grow: 1;
    margin-right: 10px;
    text-overflow: ellipsis;
    overflow: hidden;
}
