<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Settings/Styles.uss?fileID=7433441132597879392&amp;guid=e6702a426de0a44fda3691e2135d7411&amp;type=3#Styles"/>
    <Style src="project://database/Assets/Resources/UI/ExpandableList/Styles.uss?fileID=7433441132597879392&amp;guid=e517c859f0f2047eeb774c738afb6ffd&amp;type=3#Styles"/>
    <ExpandableList name="List" focusable="true" style="flex-grow: 0; flex-basis: auto; flex-direction: column; overflow: hidden; flex-shrink: 0; height: 60px; border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; border-bottom-left-radius: 8px; transition-property: height; transition-duration: 1s; margin-bottom: 10px;">
        <ui:VisualElement name="Header" class="primary" style="flex-grow: 0; width: 100%; height: 60px; flex-direction: row; align-self: flex-start; align-items: center; justify-content: space-between; flex-shrink: 0; padding-top: 10px; padding-right: 12px; padding-bottom: 10px; padding-left: 12px; overflow: visible;">
            <ui:Label text="TEST" name="ListName" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; font-size: 28px; -unity-font-style: normal;"/>
            <ui:Image source="" name="Arrow" style="background-image: url(&quot;project://database/Assets/Images/HUD/TriangleIcon.png?fileID=2800000&amp;guid=8f9c29442f01da7da8cc4ce9c2155acc&amp;type=3#TriangleIcon&quot;);"/>
        </ui:VisualElement>
        <ui:VisualElement name="Options" class="background" style="padding-top: 10px; margin-bottom: 0; padding-bottom: 10px; padding-left: 10px; padding-right: 10px; overflow: visible; flex-shrink: 0;"/>
    </ExpandableList>
</ui:UXML>
