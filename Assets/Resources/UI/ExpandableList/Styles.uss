ExpandableList {
    flex-shrink: 0;
    height: 60px;
    min-height: 60px;
    max-height: 460px;
    margin-bottom: 10px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    transition-property: height;
    transition-duration: 1s;
    overflow: hidden;
}

#header {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    width: 100%;
    height: 60px;
    align-self: flex-start;
    padding-top: 10px;
    padding-right: 12px;
    padding-bottom: 10px;
    padding-left: 12px;
    justify-content: flex-end;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    transition-property: border-radius;
    transition-duration: 0.2s;
}

ExpandableList:focus #header {
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
}

#options-container {
    padding-top: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    flex-shrink: 0;
    max-height: 400px;
}

#options-container > * {
    opacity: 0.2;
    transition-property: opacity;
    transition-duration: 0.5s;
}

ExpandableList:focus > #options-container > * {
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.5s;
}

#arrow {
    height: 32px;
    width: 32px;
    aspect-ratio: 1;
    background-color: rgba(255, 255, 255, 0);
    rotate: 90deg;
    transition-property: rotate;
    transition-duration: 1s;
    background-image: url("project://database/Assets/Images/HUD/TriangleIcon.png?fileID=2800000&guid=8f9c29442f01da7da8cc4ce9c2155acc&type=3#TriangleIcon");
}

ExpandableList:focus #arrow {
    height: 32px;
    width: 32px;
    aspect-ratio: 1;
    background-image: url("project://database/Assets/Images/HUD/TriangleIcon.png?fileID=2800000&guid=8f9c29442f01da7da8cc4ce9c2155acc&type=3#TriangleIcon");
    background-color: rgba(255, 255, 255, 0);
    rotate: 180deg;
    transition-property: rotate;
    transition-duration: 1s;
}

ExpandableListItem {
    flex-shrink: 0;
    margin-bottom: 10px;
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    flex-grow: 0;
    height: 40px;
}

#item-name {
    font-size: 24px;
}
