PauseMenu {
    flex-shrink: 0;
    flex-grow: 0;
    width: 80%;
    height: 80%;
    align-self: center;
    align-items: stretch;
    margin-top: 50px;
    background-color: rgba(0, 0, 0, 0.98);
    cursor: url("project://database/Assets/Images/HUD/dynamicReticle.png?fileID=2800000&guid=2e46087ed43f61a77b86ed9f0612a5b7&type=3#dynamicReticle");
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    position: absolute;
}

.unity-tab-view {
    flex-shrink: 0;
    flex-grow: 1;
}

.unity-tab-view__header-container {
    flex-direction: row;
    flex-shrink: 0;
    background-color: var(--Secondary);
    padding-top: 2px;
    padding-left: 2px;
}

.unity-tab__header {
    align-items: center;
    align-self: flex-start;
    flex-direction: row;
    padding-left: 20px;
    padding-right: 20px;
    min-height: 24px;
    flex-shrink: 0;
    background-color: var(--Primary);
    margin-top: 0;
}

.unity-tab__header-label {
    transition-property: color;
    transition-duration: 0.3s;
    color: rgba(229, 229, 229, 0.95);
}

.unity-tab__header-underline {
    position: absolute;
    left: 2px;
    bottom: auto;
    height: 5px;
    width: 5px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    transition-property: background-color, height, width, border-radius;
    transition-duration: 0.3s, 0.3s, 0.3s, 0.3s;
    background-color: rgba(207, 207, 207, 0.2);
    top: 2px;
}

.unity-tab__header:hover > .unity-tab__header-label {
    color: var(--Background);
}

.unity-tab__header:hover > .unity-tab__header-underline {
    background-color: var(--Background);
}

.unity-tab__header:checked > .unity-tab__header-label {
    color: var(--Secondary-Text);
}

.unity-tab__header:checked > .unity-tab__header-underline {
    background-color: var(--Secondary-Text);
    width: 8px;
    height: 8px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
}

#unity-tab-view__content-container {
    flex-grow: 1;
    flex-shrink: 0;
}

.unity-tab-view .unity-tab {
    display: none;
    background-color: var(--Background);
    flex-grow: 1;
    flex-shrink: 0;
}

.unity-tab-view .unity-tab:checked {
    display: flex;
}

#unity-tab__content-container {
    flex-shrink: 0;
    flex-grow: 1;
    justify-content: center;
    align-items: center;
}

.tabContent {
    flex-shrink: 0;
    align-self: center;
    align-items: flex-start;
    align-content: flex-start;
    justify-content: center;
    flex-grow: 1;
}

#Match Button {
    width: auto;
    height: 40px;
}

PauseMenuControl {
    flex-grow: 1;
    flex-direction: row;
    margin-bottom: 10px;
    align-items: center;
    flex-shrink: 0;
    align-self: stretch;
    justify-content: space-between;
    align-content: flex-start;
}

.unity-base-field {
    overflow: hidden;
    flex-direction: row;
    flex-shrink: 1;
    align-self: flex-start;
}

.unity-toggle {
    color: var(--Primary-Text);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: var(--Secondary);
    border-right-color: var(--Secondary);
    border-top-color: var(--Secondary);
    border-bottom-color: var(--Secondary);
    padding-top: 3px;
    padding-right: 3px;
    padding-bottom: 3px;
    padding-left: 3px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    transition-property: border-color;
    transition-duration: 0.3s;
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 0;
    justify-content: center;
}

.unity-toggle:checked {
    border-top-color: var(--Primary);
    border-right-color: var(--Primary);
    border-bottom-color: var(--Primary);
    border-left-color: var(--Primary);
}

.unity-toggle__label {
    margin-right: 5px;
    color: var(--Secondary-Text);
    -unity-font-style: italic;
    transition-property: color;
    transition-duration: 0.3s;
}

.unity-toggle:checked > .unity-toggle__label {
    color: var(--Primary-Text);
    -unity-font-style: normal;
}

.unity-toggle__input {
    flex-direction: row;
    align-self: center;
}

.unity-toggle__checkmark {
    width: 14px;
    height: 14px;
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(0, 0, 0, 0);
    transition-property: -unity-background-image-tint-color;
    transition-duration: 0.3s;
}

.unity-toggle > .unity-toggle__input:checked > .unity-toggle__checkmark {
    -unity-background-image-tint-color: var(--Primary-Text);
    background-image: url("project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=7433338533053954386&guid=f44cb77a187664828a3f3648ad4e40b2&type=3#check@2x");
}

PauseMenuDebug {
    align-self: stretch;
    flex-grow: 0;
    flex-direction: row;
    flex-shrink: 0;
    margin-bottom: 10px;
}
