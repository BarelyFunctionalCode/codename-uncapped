PauseMenu {
    flex-shrink: 0;
    flex-grow: 0;
    width: 80%;
    height: 80%;
    align-self: center;
    align-items: stretch;
    margin-top: 50px;
    background-color: rgba(0, 0, 0, 0.98);
    cursor: url("project://database/Assets/Images/HUD/dynamicReticle.png?fileID=2800000&guid=2e46087ed43f61a77b86ed9f0612a5b7&type=3#dynamicReticle");
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    position: absolute;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.3s;
}

PauseMenu.active-menu {
    opacity: 1;
}

#Match Button {
    width: auto;
    height: 40px;
}

PauseMenuControl {
    flex-grow: 1;
    flex-direction: row;
    margin-bottom: 10px;
    align-items: center;
    flex-shrink: 0;
    align-self: stretch;
    justify-content: space-between;
    align-content: flex-start;
}

PauseMenuDebug {
    align-self: stretch;
    flex-grow: 0;
    flex-direction: row;
    flex-shrink: 0;
    margin-bottom: 10px;
}