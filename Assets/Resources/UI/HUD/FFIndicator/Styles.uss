:root {
}

FFIndicatorManager {
    position: absolute;
    width: 100%;
    height: 100%;
}

FFIndicator {
    position: absolute;
    width: 100px;
    height: 100px;
    scale: 20 20;
    rotate: 1080deg;
    opacity: 0;
    transition-property: opacity, rotate, scale;
    transition-duration: 0.5s, 0s, 0s;
    flex-shrink: 0;
    transition-delay: 0s, 0.5s, 0.5s;
    --vector-line-color: rgba(217, 32, 32, 0.8);
    transform-origin: center;
    top: 0;
    left: 0;
    transition-timing-function: ease, ease, ease;
}

FFIndicator.active {
    rotate: 0;
    scale: 1 1;
    transition-property: opacity, rotate, scale;
    transition-duration: 0.3s, 1s, 0.3s;
    transition-timing-function: ease, ease-out-cubic, ease-out-cubic;
    transition-delay: 0s, 0s, 0s;
    opacity: 1;
}

#top-label {
    position: absolute;
    top: -20px;
    left: -3px;
}

#bottom-label {
    position: absolute;
    bottom: -20px;
    right: -3px;
    -unity-text-align: middle-right;
}

Label {
    opacity: 0;
    transition-delay: 0s;
    transition-duration: 0.2s;
    transition-property: opacity;
    transition-timing-function: ease;
}

FFIndicator.active > Label {
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.2s;
    transition-timing-function: ease;
    transition-delay: 0.5s;
}
