:root {
    --Loadout-Item-Color: var(--Primary);
    --Loadout-Item-Text-Color: var(--Primary-Text);
}

LoadoutItemUI {
    --vector-line-color: var(--Loadout-Item-Color);
    align-items: stretch;
    margin-top: 5px;
    margin-right: 5px;
    margin-bottom: 5px;
    margin-left: 5px;
    flex-grow: 1;
    flex-shrink: 1;
    position: relative;
    align-self: stretch;
    overflow: hidden;
    --cooldown-color: rgba(224, 43, 43, 0.82);
    justify-content: center;
    transition-property: rotate, scale;
    transition-timing-function: linear, linear;
    transition-duration: 0.1s, 0.1s;
}

LoadoutItemUI > Image {
    width: auto;
    aspect-ratio: 1;
    height: 45px;
    align-self: center;
    -unity-background-image-tint-color: var(--Loadout-Item-Text-Color);
}

LoadoutItemUI > RetroNumber {
    flex-grow: 1;
    -unity-text-align: middle-center;
    min-height: 20px;
    padding-top: 7px;
    padding-right: 7px;
    padding-bottom: 7px;
    padding-left: 7px;
    width: 100%;
    color: var(--Loadout-Item-Text-Color);
}

LoadoutItemUI #cooldown-label {
    position: absolute;
    width: 100%;
    height: 50%;
    flex-shrink: 0;
    flex-grow: 1;
    -unity-text-align: middle-center;
    padding-top: 0;
    padding-right: 10px;
    padding-bottom: 0;
    padding-left: 10px;
    color: rgb(79, 24, 24);
    align-self: center;
    flex-direction: column;
}

.loadout-item-transition {
    scale: 1.1 1.1 1.1;
    rotate: 5deg;
    filter: hue-rotate(2);
}
