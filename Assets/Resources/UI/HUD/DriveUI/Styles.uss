:root {
    --Drive-Outline: rgba(189, 253, 199, 0.95);
    --Drive-Fill: rgba(89, 253, 113, 0.1);
}

DriveUI {
    position: relative;
    left: auto;
    margin-bottom: 0;
    width: 120px;
    height: 120px;
    flex-shrink: 0;
    border-top-color: var(--Drive-Outline);
    border-right-color: var(--Drive-Outline);
    border-bottom-color: var(--Drive-Outline);
    border-left-color: var(--Drive-Outline);
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
    border-top-left-radius: 60px;
    border-top-right-radius: 60px;
    border-bottom-right-radius: 60px;
    border-bottom-left-radius: 60px;
    transition-property: width, background-color, height, border-radius, border-color;
    transition-duration: 0.5s, 0.5s, 0.5s, 0.5s, 0.5s;
    background-color: rgba(0, 0, 0, 0.05);
    overflow: hidden;
    align-self: center;
}

DriveUI.ready {
    width: 300px;
    height: 60px;
    border-top-left-radius: 30px;
    border-top-right-radius: 30px;
    border-bottom-right-radius: 30px;
    border-bottom-left-radius: 30px;
    background-color: var(--Drive-Fill);
}

DriveUI.active {
    border-top-color: var(--Active-Color);
    border-right-color: var(--Active-Color);
    border-bottom-color: var(--Active-Color);
    border-left-color: var(--Active-Color);
}

DriveUI.cooldown {
    border-top-color: var(--Cooldown-Color);
    border-right-color: var(--Cooldown-Color);
    border-bottom-color: var(--Cooldown-Color);
    border-left-color: var(--Cooldown-Color);
}

DriveUI > #online-text {
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.2s;
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 10px 100px;
    padding-top: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    -unity-text-align: middle-center;
    letter-spacing: 5px;
    color: var(--Drive-Outline);
}

DriveUI.online > #online-text {
    opacity: 1;
}

DriveUI > #number-text {
    flex-shrink: 0;
    flex-grow: 1;
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    -unity-text-align: middle-center;
    letter-spacing: 5px;
    position: absolute;
    font-size: 40px;
    align-self: center;
    height: 100%;
    width: 100%;
    color: rgba(0, 0, 0, 0.9);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.2s;
}

DriveUI.active > #number-text {
    opacity: 1;
}

DriveUI.cooldown > #number-text {
    opacity: 1;
}

DriveUI > #active-fill-bar {
    left: 0;
    bottom: 0;
    right: 0;
    opacity: 0;
    position: absolute;
    background-color: var(--Active-Color);
    height: 100%;
    transition-property: opacity;
    transition-duration: 0.5s;
}

DriveUI.active > #active-fill-bar {
    opacity: 1;
}

DriveUI > #cooldown-fill-bar {
    left: 0;
    bottom: 0;
    opacity: 1;
    position: absolute;
    top: 0;
    background-color: var(--Cooldown-Color);
    width: 100%;
    transition-property: opacity;
    transition-duration: 0.5s;
}

DriveUI.ready > #cooldown-fill-bar {
    opacity: 0;
}
