:root {
}

.notice-container {
    flex-grow: 1;
    position: absolute;
    flex-shrink: 0;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

.notice-text {
    font-size: 100px;
    white-space: normal;
    -unity-text-align: middle-center;
}

LobbyPC {
    flex-grow: 1;
    flex-shrink: 0;
    width: 100%;
    height: 100%;
}

.unity-tab__header-label {
    font-size: 30px;
}
