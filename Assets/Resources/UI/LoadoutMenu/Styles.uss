.showcase {
    background-color: rgba(0, 0, 0, 0.6);
    margin-bottom: 30px;
    aspect-ratio: 1;
    min-height: 50%;
    flex-shrink: 1;
    flex-grow: 1;
}

#Background {
    flex-grow: 1;
    -unity-material: none;
    background-color: rgb(0, 0, 0);
    flex-shrink: 0;
}

#LoadoutMenu {
    -unity-material: none;
    flex-grow: 1;
    flex-shrink: 0;
}

#MenuBar {
    flex-direction: row;
    justify-content: space-between;
    height: 50px;
    margin-top: 5px;
    margin-right: 5px;
    margin-bottom: 5px;
    margin-left: 5px;
    padding-left: 30px;
}

#ContentBackground {
    flex-shrink: 0;
    flex-grow: 1;
    margin-right: 5px;
    margin-bottom: 10px;
    margin-left: 5px;
    background-color: rgb(0, 0, 0);
}

#Content {
    -unity-material: url("project://database/Assets/Shaders/RetroStaticUI.shadergraph?fileID=-876546973899608171&guid=69700b1ae33124c94ba8dda5b7003190&type=3#RetroStaticUI");
    padding-top: 20px;
    padding-right: 20px;
    padding-bottom: 20px;
    padding-left: 20px;
    flex-shrink: 0;
    flex-grow: 1;
    flex-direction: row;
}

#Preview {
    flex-grow: 0;
    margin-right: 20px;
    width: 40%;
    align-items: center;
    overflow: hidden;
}

#Buttons {
    flex-grow: 0;
    flex-direction: row;
    justify-content: space-around;
    margin-top: 20px;
    margin-right: 20px;
    margin-bottom: 20px;
    margin-left: 20px;
    min-height: 100px;
    width: 80%;
    align-content: flex-start;
    align-items: center;
}

#LoadoutSelection {
    flex-grow: 1;
    flex-direction: row;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    padding-top: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
}

#OptionsLists {
    width: 40%;
}

#ItemInfo {
    flex-grow: 1;
    align-items: center;
}

#ItemPreview {
    max-width: 90%;
    background-image: url("project://database/Assets/Materials/ShowcaseRenderTexture.renderTexture?fileID=8400000&guid=f7a2da3411f0947c29d362de35715d18&type=2#ShowcaseRenderTexture");
}
