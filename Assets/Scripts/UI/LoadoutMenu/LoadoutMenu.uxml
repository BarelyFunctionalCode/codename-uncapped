    <ui:VisualElement name="LoadoutMenu" class="primary" style="flex-grow: 1; -unity-material: url(&quot;&quot;);">
        <ui:VisualElement name="MenuBar" style="flex-grow: 0; -unity-material: url(&quot;&quot;); height: 50px; margin-left: 5px; margin-right: 5px; margin-bottom: 5px; margin-top: 5px; flex-direction: row; justify-content: space-between;">
