<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="ExpandableListItem" src="project://database/Assets/Scripts/UI/LoadoutMenu/ExpandableListItem.uxml?fileID=9197481963319205126&amp;guid=6ed6bc8c335f941e2a0dae4a7b02c932&amp;type=3#ExpandableListItem"/>
